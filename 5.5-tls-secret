##tls secret 

openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
  -keyout kibana.key -out kibana.crt \
  -subj "/CN=kibana.example.com"

kubectl -n logging create secret tls kibana-tls \
  --cert=kibana.crt --key=kibana.key
##ingress
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: kibana-logs
  namespace: logging
  annotations:
    kubernetes.io/ingress.class: nginx
spec:
  tls:
    - hosts:
        - kibana.example.com
      secretName: kibana-tls
  rules:
    - host: kibana.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kibana-logs-kb-http
                port:
                  number: 5601
                  
##apply and test
kubectl apply -f manifests/kibana-ingress.yaml

##Troubleshooting
Was not pointing to public DNS. Resolved by 
